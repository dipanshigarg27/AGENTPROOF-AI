# ============================================================
# AgentProof AI — Environment Variables
# Copy this file to backend/.env and fill in your values
# ============================================================

# --- Tavily Search API (REQUIRED for claim verification) ---
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI Provider Keys (at least ONE required for live mode) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (free tier available): https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Bifrost Gateway (optional — uses Docker) ---
# If Docker is running: docker run -d -p 8080:8080 -e OPENAI_API_KEY=... maximhq/bifrost
# Leave as default if running Bifrost locally on port 8080
BIFROST_BASE_URL=http://localhost:8080
# BIFROST_API_KEY=  # Only needed if Bifrost requires authentication (usually not for local)

# --- Backend Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./agentproof.db

# --- Frontend Settings ---
VITE_API_BASE_URL=http://localhost:8000
